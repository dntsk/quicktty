+    /// Current tail only: final-capture policy belongs to the caller.
+    export fn quicktty_surface_read_tail(
+        surface_: ?*Surface,
+        maximum_utf8_bytes: usize,
+        result_: ?*Text,
+        is_truncated_: ?*bool,
+    ) bool {
+        const surface = surface_ orelse return false;
+        const result = result_ orelse return false;
+        const is_truncated = is_truncated_ orelse return false;
+        result.* = .{
+            .tl_px_x = -1, .tl_px_y = -1, .offset_start = 0,
+            .offset_len = 0, .text = null, .text_len = 0,
+        };
+        is_truncated.* = false;
+        if (maximum_utf8_bytes == 0 or maximum_utf8_bytes > 65536) return false;
+
+        const storage = global.alloc().alloc(u8, maximum_utf8_bytes) catch return false;
+        defer global.alloc().free(storage);
+        var suffix = TailWriter.init(storage);
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const screen = core_surface.io.terminal.screens.active;
+        const pages = &screen.pages;
+        const bottom = pages.getBottomRight(.screen) orelse return false;
+        // Walk backward from the actual bottom, never scan full history to
+        // resolve an absolute row. The budget bounds rows, not UTF-8 per cell.
+        // Include the actual active grid even for tiny byte limits: the
+        // bottom rows can be blank and are omitted by the page formatter.
+        const row_budget = @min(@max(maximum_utf8_bytes, @as(usize, pages.rows)), 4096);
+        const first = pages.getTopLeft(.screen);
+        var top = bottom.up(@intCast(row_budget - 1)) orelse first;
+        top.x = 0;
+        const omitted_rows = top.node != first.node or top.y != first.y;
+        // Pins are already ordered by the bounded upward walk. Avoid
+        // Selection ordering, which resolves points through full history.
+        var formatter: terminal.formatter.PageListFormatter = .init(pages, .{
+            .emit = .plain, .unwrap = true, .trim = false,
+        });
+        formatter.top_left = top;
+        formatter.bottom_right = bottom;
+        formatter.format(&suffix.writer) catch return false;
+        suffix.writer.flush() catch return false;
+
+        // Formatter emits whole UTF-8 scalars. A byte-bounded suffix can
+        // start mid-scalar: discard only its continuation bytes (at most 3).
+        // This does NOT promise a grapheme-cluster boundary.
+        var skip: usize = 0;
+        while (skip < suffix.len and suffix.at(skip) & 0xc0 == 0x80) : (skip += 1) {}
+        if (skip > 3) return false;
+        const text = global.alloc().allocSentinel(u8, suffix.len - skip, 0) catch return false;
+        for (text, 0..) |*byte, i| byte.* = suffix.at(skip + i);
+        if (!std.unicode.utf8ValidateSlice(text)) {
+            global.alloc().free(text);
+            return false;
+        }
+        result.text = text.ptr;
+        result.text_len = text.len;
+        is_truncated.* = omitted_rows or suffix.dropped or skip != 0;
+        return true;
+    }
+
+    /// Zig 0.15 Writer sink retaining only a suffix, never the full dump.
+    /// No pin map, allocating formatter, or intermediate history string.
+    const TailWriter = struct {
+        writer: std.Io.Writer,
+        storage: []u8,
+        start: usize = 0,
+        len: usize = 0,
+        dropped: bool = false,
+
+        fn init(storage: []u8) TailWriter {
+            std.debug.assert(storage.len > 0);
+            return .{
+                .writer = .{ .buffer = &.{}, .end = 0, .vtable = &.{ .drain = drain } },
+                .storage = storage,
+            };
+        }
+
+        fn at(self: *const TailWriter, index: usize) u8 {
+            return self.storage[(self.start + index) % self.storage.len];
+        }
+
+        fn append(self: *TailWriter, bytes: []const u8) void {
+            const cap = self.storage.len;
+            if (bytes.len >= cap) {
+                self.dropped = self.dropped or self.len != 0 or bytes.len > cap;
+                @memcpy(self.storage, bytes[bytes.len - cap ..]);
+                self.start = 0;
+                self.len = cap;
+                return;
+            }
+            const drop = (self.len + bytes.len) -| cap;
+            if (drop > 0) {
+                self.dropped = true;
+                self.start = (self.start + drop) % cap;
+                self.len -= drop;
+            }
+            const end = (self.start + self.len) % cap;
+            const first = @min(bytes.len, cap - end);
+            @memcpy(self.storage[end .. end + first], bytes[0..first]);
+            @memcpy(self.storage[0 .. bytes.len - first], bytes[first..]);
+            self.len += bytes.len;
+        }
+
+        fn drain(w: *std.Io.Writer, data: []const []const u8, splat: usize) std.Io.Writer.Error!usize {
+            std.debug.assert(data.len > 0);
+            const self: *TailWriter = @fieldParentPtr("writer", w);
+            self.append(w.buffer[0..w.end]);
+            w.end = 0;
+            var count: usize = 0;
+            for (data[0 .. data.len - 1]) |bytes| {
+                self.append(bytes);
+                count = std.math.add(usize, count, bytes.len) catch return error.WriteFailed;
+            }
+            const pattern = data[data.len - 1];
+            const repeated = std.math.mul(usize, pattern.len, splat) catch return error.WriteFailed;
+            count = std.math.add(usize, count, repeated) catch return error.WriteFailed;
+            if (pattern.len == 0 or splat == 0) return count;
+            // Skip whole repetitions that cannot survive in the suffix.
+            // Even a huge splat takes O(capacity), not O(emitted bytes).
+            const keep = @min(splat, self.storage.len / pattern.len + 1);
+            if (keep < splat) self.dropped = true;
+            for (0..keep) |_| self.append(pattern);
+            return count;
+        }
+    };
+
+    test "QuickTTY tail writer retains suffix across chunks and huge writes" {
+        var storage: [4]u8 = undefined;
+        var sink = TailWriter.init(&storage);
+        try sink.writer.writeAll("ab");
+        try sink.writer.writeAll("cd");
+        try std.testing.expect(!sink.dropped);
+        try sink.writer.writeAll("ef");
+        for ("cdef", 0..) |byte, i| try std.testing.expectEqual(byte, sink.at(i));
+        try std.testing.expect(sink.dropped);
+        try sink.writer.writeAll("0123456789");
+        for ("6789", 0..) |byte, i| try std.testing.expectEqual(byte, sink.at(i));
+        try sink.writer.splatByteAll('x', 1000000);
+        try sink.writer.flush();
+        try std.testing.expectEqual(@as(usize, 4), sink.len);
+        for (0..4) |i| try std.testing.expectEqual(@as(u8, 'x'), sink.at(i));
+    }
+
+    test "QuickTTY tail writer formats selected Unicode pins without pin map" {
+        const alloc = std.testing.allocator;
+        var t = try terminal.Terminal.init(alloc, .{ .cols = 80, .rows = 24 });
