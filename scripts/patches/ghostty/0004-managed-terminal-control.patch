+            .emit = .plain, .unwrap = true, .trim = false,
+        });
+        formatter.content = .{ .selection = terminal.Selection.init(
+            screen.pages.getTopLeft(.screen), screen.pages.getBottomRight(.screen).?, false,
+        ) };
+        var storage: [3]u8 = undefined;
+        var sink = TailWriter.init(&storage);
+        try formatter.format(&sink.writer);
+        try sink.writer.flush();
+        try std.testing.expect(sink.dropped);
+        try std.testing.expectEqual(@as(u8, 0x9a), sink.at(0));
+        try std.testing.expectEqual(@as(u8, 0xa1), sink.at(1));
+        try std.testing.expectEqual(@as(u8, 'z'), sink.at(2));
     }

