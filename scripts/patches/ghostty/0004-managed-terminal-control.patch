+            .{ .fd = fd, .events = posix.POLL.IN, .revents = 0 },
+            .{ .fd = quit, .events = posix.POLL.IN, .revents = 0 },
+        };
+        var quitfds: [1]posix.pollfd = .{
+            .{ .fd = quit, .events = posix.POLL.IN, .revents = 0 },
+        };
