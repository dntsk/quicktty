+                // Linux PTY masters report EIO after the slave closes;
+                // Darwin normally reports zero. Both follow queued data.
+                error.InputOutput => @as(usize, 0),
+                error.WouldBlock => {
+                    // HUP itself is not EOF. We already attempted the final
+                    // drain; an unconfirmed hangup must not become COMPLETE.
+                    if (hung_up) return;
+                    _ = posix.poll(&pollfds, -1) catch return;
+                    if (pollfds[1].revents != 0) return;
+                    if (pollfds[0].revents & posix.POLL.NVAL != 0) return;
+                    hung_up = pollfds[0].revents & posix.POLL.HUP != 0;
+                    if (!hung_up and pollfds[0].revents & posix.POLL.ERR != 0) return;
