+/// Exact argv, with no quoting, shell parser, login wrapper, or fallback.
+fn managedCommand(alloc: Allocator, path: [:0]const u8) ![]const [:0]const u8 {
+    if (builtin.os.tag == .windows or build_config.flatpak) return error.UnsupportedManagedLaunch;
+    if (path.len == 0 or path.len >= std.fs.max_path_bytes or
+        !std.fs.path.isAbsolute(path) or !std.unicode.utf8ValidateSlice(path))
+        return error.InvalidManagedHelper;
+    const helper = try std.fs.openFileAbsolute(path, .{});
+    defer helper.close();
+    const stat = try helper.stat();
+    if (stat.kind != .file or stat.mode & 0o111 == 0) return error.InvalidManagedHelper;
+    return managedArgv(alloc, path);
+}
+
+fn managedArgv(alloc: Allocator, path: [:0]const u8) ![]const [:0]const u8 {
+    const args = try alloc.alloc([:0]const u8, 3);
+    errdefer alloc.free(args);
+    args[0] = try alloc.dupeZ(u8, path);
+    args[1] = "internal";
+    args[2] = "launch";
+    return args;
+}
+
+test "QuickTTY managed argv is copied and never shell quoted" {
+    const alloc = std.testing.allocator;
+    var path = "/Applications/Quick TTY's.app/helper".*;
+    const args = try managedArgv(alloc, &path);
+    defer alloc.free(args);
+    defer alloc.free(args[0]);
+    path[1] = 'X';
+    try std.testing.expectEqual(@as(usize, 3), args.len);
+    try std.testing.expectEqualStrings("/Applications/Quick TTY's.app/helper", args[0]);
+    try std.testing.expectEqualStrings("internal", args[1]);
+    try std.testing.expectEqualStrings("launch", args[2]);
+}
