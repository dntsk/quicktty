+// A null result is not proof of exit: keep cleanup ownership and poll later.
+// A value means the child was reaped, or ECHILD released our ownership.
+fn probeDarwinChild(pid: posix.pid_t) ?u32 {
+    const unknown: u32 = std.math.maxInt(u32);
+    // Never allow waitpid's process-group or any-child forms.
+    if (pid <= 0) return null;
+
+    var raw_status: c_int = undefined;
+    const rc = posix.system.waitpid(pid, &raw_status, @intCast(posix.W.NOHANG));
+    switch (posix.errno(rc)) {
+        .SUCCESS => {},
+        .CHILD => return unknown, // No child remains ours; never reuse this PID.
+        // Even EINTR gets just one attempt per callback. Further attempts
+        // are paced by the timer, not a syscall or registration retry loop.
+        else => return null,
+    }
+    if (rc != pid) return null;
+
+    const raw: u32 = @bitCast(raw_status);
+    if (posix.W.IFEXITED(raw)) return posix.W.EXITSTATUS(raw);
+    if (posix.W.IFSIGNALED(raw)) {
+        const signal: u32 = posix.W.TERMSIG(raw);
+        return if (signal > 0 and signal <= 127) 128 + signal else unknown;
+    }
+
+    // A traced stop is not an exit. Keep ownership and observe again.
+    return null;
+}
+
+fn processExitDarwin(
+    ud: ?*anyopaque,
+    _: *xev.Loop,
+    c: *xev.Completion,
+    r: xev.Result,
+) xev.CallbackAction {
+    const td: *termio.Termio.ThreadData = @ptrCast(@alignCast(ud.?));
+    const exec = &td.backend.exec;
+    if (exec.darwin_exit.stopped or td.loop.stopped() or exec.exited) return .disarm;
+    if (r.proc) |_| {} else |err| switch (err) {
+        error.Canceled => {
+            exec.darwin_exit = .{ .stopped = true };
+            return .disarm;
+        },
+        else => log.warn("error watching child exit err={}", .{err}),
+    }
+
+    const pid = c.op.proc.pid;
+    if (probeDarwinChild(pid)) |exit_code| {
+        exec.darwin_exit.poll_pid = null;
+        processExitCommon(td, exit_code);
+        return .disarm;
+    }
+
+    // An event error, interrupted wait, or premature event is not an exit.
+    // Disarm the proc completion; never spin re-registering a failed watcher.
+    // The existing timer owns further probes, including while unfocused.
+    exec.darwin_exit.poll_pid = pid;
+    if (exec.termios_timer_c.state() != .active) {
+        exec.termios_timer.run(
+            td.loop,
+            &exec.termios_timer_c,
+            250,
+            termio.Termio.ThreadData,
+            td,
+            termiosTimer,
+        );
+    }
+    return .disarm;
+}
+
 fn processExit(
     td_: ?*termio.Termio.ThreadData,
     _: *xev.Loop,
@@ -332,7 +428,11 @@
     _ = r catch |err| switch (err) {
         // This is sent when our timer is canceled. That's fine.
-        error.Canceled => return .disarm,
+        error.Canceled => {
